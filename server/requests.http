@api = http://localhost:3001/api

### Registro
POST {{api}}/auth/register
Content-Type: application/json

{ "email": "ana@test.com", "password": "supersecreta", "displayName": "Ana" }

### Login
POST {{api}}/auth/login
Content-Type: application/json

{ "email": "ana@test.com", "password": "supersecreta" }

### Quién soy
GET {{api}}/auth/me

POST {{api}}/auth/logout

### Registro con datos inválidos
POST {{api}}/auth/register
Content-Type: application/json

{ "email": "mal", "password": "123" }

### Juegos
GET {{api}}/games

### Crear torneo
POST {{api}}/tournaments
Content-Type: application/json

{
    "name": "Copa de Otoño",
    "gameId": 1,
    "startsAt": "2027-01-10T18:00:00Z",
    "maxTeams": 8,
    "teamSize": 5,
    "bestOf": 3,
    "rules": "Sin trampas"
}

### Crear torneo con datos inválidos
POST {{api}}/tournaments
Content-Type: application/json

{ "name": "x", "gameId": 1, "startsAt": "2020-01-01", "maxTeams": 1, "teamSize": 5, "bestOf": 2 }

### Lista pública
GET {{api}}/tournaments

### Lista filtrada
GET {{api}}/tournaments?game=league-of-legends&status=REGISTRATION

### Ver un torneo (cambia el slug por el tuyo)
@slug = copa-de-otono-xxxxxx
GET {{api}}/tournaments/{{slug}}

### Editar
PATCH {{api}}/tournaments/{{slug}}
Content-Type: application/json

{ "maxTeams": 16 }

### Abrir inscripciones
POST {{api}}/tournaments/{{slug}}/open

### Borrar
DELETE {{api}}/tournaments/{{slug}}

### Login con el segundo usuario
POST {{api}}/auth/login
Content-Type: application/json

{ "email": "otro@test.com", "password": "supersecreta" }

### Crear equipo
POST {{api}}/teams
Content-Type: application/json

{ "name": "Lobos", "tag": "lob" }

### Mis equipos
GET {{api}}/teams/mine

### Ver equipo
GET {{api}}/teams/1

### Unirse (con el inviteCode que te dio "Crear equipo")
POST {{api}}/join/PEGA-AQUI-EL-CODIGO

### Nuevo código de invitación
POST {{api}}/teams/1/invite-code

### Salir del equipo / expulsar (userId del jugador)
DELETE {{api}}/teams/1/members/3

### Inscribir equipo
POST {{api}}/tournaments/{{slug}}/registrations
Content-Type: application/json

{ "teamId": 1 }

### Ver inscripciones (organizador)
GET {{api}}/tournaments/{{slug}}/registrations

### Aceptar
PATCH {{api}}/tournaments/{{slug}}/registrations/1
Content-Type: application/json

{ "status": "ACCEPTED" }

### Retirar inscripción
DELETE {{api}}/tournaments/{{slug}}/registrations/1